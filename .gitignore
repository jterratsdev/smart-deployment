# -- CLEAN
tmp/
# use yarn by default, so ignore npm
package-lock.json
!site/package-lock.json
site/dist/

# never checkin npm config
.npmrc

# debug logs
npm-error.log
yarn-error.log


# compile source
lib

# test artifacts
*xunit.xml
*checkstyle.xml
*unitcoverage
.nyc_output
coverage
test_session*
stdout*.txt
stderr*.txt

# generated docs (auto-generated API docs, not manual documentation)
# docs/api
# typedoc output

# ignore sfdx-trust files
*.tgz
*.sig
package.json.bak.


npm-shrinkwrap.json
oclif.manifest.json
oclif.lock

# -- CLEAN ALL
*.tsbuildinfo
.eslintcache
.wireit
.wrangler/
node_modules
.tmp-npm-cache/

# --
# put files here you don't want cleaned with sf-clean
.smart-deployment/

# os specific files
.DS_Store
.idea

# Open Orchestra ephemeral runtime state
.agent-workflow/active-runtime.json
.agent-workflow/backups/
.agent-workflow/runtime-sessions/
.agent-workflow/telemetry/*
!.agent-workflow/telemetry/.gitkeep

