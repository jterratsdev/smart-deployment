# -- CLEAN
tmp/
# use yarn by default, so ignore npm
package-lock.json

# never checkin npm config
.npmrc

# debug logs
npm-error.log
yarn-error.log


# compile source
lib

# test artifacts
*xunit.xml
*checkstyle.xml
*unitcoverage
.nyc_output
coverage
test_session*

# generated docs (auto-generated API docs, not manual documentation)
# docs/api
# typedoc output

# ignore sfdx-trust files
*.tgz
*.sig
package.json.bak.


npm-shrinkwrap.json
oclif.manifest.json
oclif.lock

# -- CLEAN ALL
*.tsbuildinfo
.eslintcache
.wireit
node_modules

# --
# put files here you don't want cleaned with sf-clean

# os specific files
.DS_Store
.idea

# >>> setup-agents (managed) >>>
# Regenerable / heavy / per-user setup-agents artifacts — safe to delete and re-generate.
# Authored state (state/, config.json, rules/, skills/, sf-skills/, playbooks/,
# project-knowledge.md, insights/) is intentionally NOT ignored.
.setup-agents/references/
.setup-agents/sf-metadata-index.json
.setup-agents/chat-history/
.setup-agents/chat-debug.jsonl
.setup-agents/tmp/

# Proprietary setup-agents generated files (customer repository policy).
/.opencode/agents/developer.md
/.setup-agents/playbooks/**
/.setup-agents/rules/**
/.setup-agents/skills/**
# <<< setup-agents (managed) <<<

# Local deployment runtime state
.smart-deployment/deployment-state.json
