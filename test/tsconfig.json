{
  "extends": "@salesforce/dev-config/tsconfig-test-strict-esm",
  "include": ["./**/*.ts", "../src/**/*.ts"],
  "exclude": ["commands/hello/**"],
  "compilerOptions": {
    "skipLibCheck": true,
    "types": ["mocha", "chai", "node"],
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "Node16",
    "module": "Node16",
    "noEmit": true,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true
  },
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "Node16",
      "moduleResolution": "Node16",
      "types": ["node"]
    }
  }
}
